# ProbeForge local development environment.
# Copy this file to .env and replace every placeholder. Never commit .env.

# PostgreSQL (local Docker Compose)
POSTGRES_DB=probeforge
POSTGRES_USER=probeforge
POSTGRES_PASSWORD=replace-with-a-local-dev-password
POSTGRES_PORT=5432

# Rust control plane and workers (loopback only by default)
PROBE_FORGE_API_ADDR=127.0.0.1:8080
PROBE_FORGE_SCHEDULER_ADDR=127.0.0.1:8081
PROBE_FORGE_EXECUTION_WORKER_ADDR=127.0.0.1:8082
PROBE_FORGE_SCHEDULER_POLL_SECONDS=5

# TypeScript analysis worker (Bun)
PROBE_FORGE_ANALYSIS_WORKER_HOST=127.0.0.1
PROBE_FORGE_ANALYSIS_WORKER_PORT=8090

# Read-only Git ingestion (Phase 5). The worker health server does not expose an
# ingestion endpoint; use the operator CLI described in docs/REPOSITORY_INGESTION.md.
# Only allow hosts your deployment actually needs. Local fixtures are disabled by
# default and must never be enabled for a network-facing worker.
PROBE_FORGE_ANALYSIS_ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
PROBE_FORGE_ANALYSIS_ALLOW_LOCAL_FIXTURES=false
PROBE_FORGE_ANALYSIS_MAX_FILES=5000
PROBE_FORGE_ANALYSIS_MAX_TOTAL_BYTES=67108864
PROBE_FORGE_ANALYSIS_MAX_FILE_BYTES=2097152
PROBE_FORGE_ANALYSIS_MAX_DEPTH=32
PROBE_FORGE_ANALYSIS_MAX_WORKSPACE_BYTES=134217728
PROBE_FORGE_ANALYSIS_MAX_GIT_OUTPUT_BYTES=8388608
PROBE_FORGE_ANALYSIS_GIT_TIMEOUT_MS=60000
PROBE_FORGE_ANALYSIS_MAX_INVENTORY_FILES=500
PROBE_FORGE_ANALYSIS_MAX_DEPENDENCIES_PER_MANIFEST=200
# Optional append-only JSONL audit destination for the operator CLI:
# PROBE_FORGE_ANALYSIS_AUDIT_LOG=tmp/ingestion-audit.jsonl
#
# Git credentials are injected at runtime by secret reference and are never
# stored here. The resolver maps secret://git/github to the environment variable
# PROBE_FORGE_SECRET_GIT_GITHUB. HTTPS uses {"kind":"http_basic","username":...,
# "password":...}; SSH uses {"kind":"ssh_private_key","privateKey":...}. Never
# commit a real credential or private key.

# Planning (Phase 7). Set provider and model together or leave both unset.
# Provider credentials are resolved by the Pi SDK from the provider environment
# (for example the provider's own *_API_KEY variable) and must never be placed
# in this file. Phase 7 is a library, not an HTTP planning endpoint.
# PROBE_FORGE_PLANNING_PROVIDER=anthropic
# PROBE_FORGE_PLANNING_MODEL=claude-sonnet-4-6
# PROBE_FORGE_PLANNING_MAX_MODEL_CALLS=6
# PROBE_FORGE_PLANNING_MAX_TOOL_CALLS=24
# PROBE_FORGE_PLANNING_MAX_TURNS=8
# PROBE_FORGE_PLANNING_MAX_RETRIES=1
# PROBE_FORGE_PLANNING_MAX_RESPONSE_TOKENS=4096
# PROBE_FORGE_PLANNING_MAX_WALL_TIME_MS=120000
# PROBE_FORGE_PLANNING_MAX_PROMPT_BYTES=65536
# PROBE_FORGE_PLANNING_MAX_TOOL_OUTPUT_BYTES=32768
# PROBE_FORGE_PLANNING_MAX_TOTAL_TOOL_OUTPUT_BYTES=131072
# PROBE_FORGE_PLANNING_MAX_PLAN_BYTES=262144
# PROBE_FORGE_PLANNING_MAX_REPOSITORY_READ_BYTES=8192
# PROBE_FORGE_PLANNING_MAX_CATALOG_ENTRIES=200
# PROBE_FORGE_PLANNING_MAX_PLANNED_TESTS=20
# PROBE_FORGE_PLANNING_MAX_LOAD_SCENARIOS=5

# Target validation (Phase 9). Private-network targets are denied by default.
# Enable only for an explicitly secured local/mock environment. Link-local and
# cloud metadata ranges remain blocked even when this flag is enabled.
PROBE_FORGE_ALLOW_PRIVATE_TARGETS=false

# Logging (tracing filter for Rust services) and structured log format.
# Set PROBE_FORGE_LOG_FORMAT=json for line-delimited JSON logs in aggregation.
RUST_LOG=info
PROBE_FORGE_LOG_FORMAT=text

# API rate limits (Phase 14). Per authenticated user, fixed 60-second window.
# The expensive bucket covers job creation and report generation.
PROBE_FORGE_API_RATE_LIMIT_PER_MINUTE=240
PROBE_FORGE_EXPENSIVE_RATE_LIMIT_PER_MINUTE=20

# Retention (Phase 14). The scheduler purges expired operational rows in bounded
# batches. Evidence and report rows past their window are also purged, but only
# through the single sanctioned retention path; recommendation-referenced
# evidence is always retained.
PROBE_FORGE_RETENTION_INTERVAL_SECONDS=3600
PROBE_FORGE_RETENTION_EVENT_DAYS=30
PROBE_FORGE_RETENTION_REPORT_DAYS=180
PROBE_FORGE_RETENTION_COUNTER_DAYS=7

# Database connection for the API, migrations, and database-backed checks. Keep
# the password in sync with POSTGRES_PASSWORD. Never commit a real value.
DATABASE_URL=postgres://probeforge:replace-with-a-local-dev-password@127.0.0.1:5432/probeforge

# Local backup/restore tooling (Phase 14) uses this container name.
PROBE_FORGE_DB_CONTAINER=probe-forge-local-postgres-1

# Authentication (Phase 3). Local browser development uses HTTP, so Secure must
# be false here. Production must set PROBE_FORGE_COOKIE_SECURE=true and serve
# the API and web app over HTTPS.
PROBE_FORGE_COOKIE_SECURE=false
PROBE_FORGE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PROBE_FORGE_SESSION_TTL_SECONDS=28800

# Provision the first account after migrations (password is prompted, never
# passed as an argument):
#   bun run user:create -- owner@example.test "Owner"
