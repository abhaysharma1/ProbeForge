# ProbeForge local development environment.
# Copy this file to .env and replace every placeholder. Never commit .env.

# PostgreSQL (local Docker Compose)
POSTGRES_DB=probeforge
POSTGRES_USER=probeforge
POSTGRES_PASSWORD=replace-with-a-local-dev-password
POSTGRES_PORT=5432

# Rust control plane and workers (loopback only by default)
PROBE_FORGE_API_ADDR=127.0.0.1:8080
PROBE_FORGE_SCHEDULER_ADDR=127.0.0.1:8081
PROBE_FORGE_EXECUTION_WORKER_ADDR=127.0.0.1:8082

# TypeScript analysis worker (Bun)
PROBE_FORGE_ANALYSIS_WORKER_HOST=127.0.0.1
PROBE_FORGE_ANALYSIS_WORKER_PORT=8090

# Logging (tracing filter for Rust services)
RUST_LOG=info

# Database migrations and schema checks (Phase 2+). Keep the password in sync
# with POSTGRES_PASSWORD. Services remain health-only until Phase 3; only the
# migration binary and tests read this value.
DATABASE_URL=postgres://probeforge:replace-with-a-local-dev-password@127.0.0.1:5432/probeforge
