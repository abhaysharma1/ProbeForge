# ProbeForge repository ignores.
# Never commit real secrets, credentials, tokens, target access details, or scan evidence.

# Environment files (placeholders only; commit .env.example instead)
.env
.env.*
!.env.example

# Node / TypeScript
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.vite/
.turbo/
.eslintcache
*.log

# Rust
target/
**/*.rs.bk

# Runtime workspaces (cloned repositories, execution artifacts)
workspaces/
tmp/

# Local database backups (never commit scan evidence or credentials)
backups/

# Local databases
*.sqlite
*.sqlite3
*.db

# Local CodeGraph index (generated, not part of the product)
.codegraph/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Test and browser-test outputs
test-results/
playwright-report/
