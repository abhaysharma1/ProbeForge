{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probeforge.invalid/schemas/probeforge.v1.schema.json",
  "title": "ProbeForge contracts v1",
  "description": "Versioned API, plan, target-authorization, run, result, and event payloads. Payloads are data only: executable commands, shell fragments, script paths, and arbitrary request programs are not representable.",
  "type": "object",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "jobGoal": {
      "type": "string",
      "enum": ["vulnerability_testing", "load_testing"]
    },
    "intensity": {
      "type": "string",
      "enum": ["low", "standard", "high"]
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "environment": {
      "type": "string",
      "enum": ["local", "staging", "production"]
    },
    "httpMethod": {
      "type": "string",
      "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
    },
    "secretReference": {
      "type": "string",
      "pattern": "^secret://[a-z0-9][a-z0-9/_.-]{0,190}$",
      "maxLength": 199
    },
    "repositoryReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!-)(?!.*\\.\\.)[A-Za-z0-9._/-]{1,200}$"
    },
    "safeJson": {
      "description": "Bounded JSON data. Recursively rejects command/script/executable keys so model output cannot describe an executable action.",
      "oneOf": [
        {
          "type": "string",
          "maxLength": 16384
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/safeJson"
          }
        },
        {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {
            "not": {
              "enum": ["command", "cmd", "script", "scripts", "executable", "shell", "entrypoint"]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/safeJson"
          }
        }
      ]
    },
    "safeJsonObject": {
      "description": "A bounded JSON object for structured configuration or evidence details.",
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "not": {
          "enum": ["command", "cmd", "script", "scripts", "executable", "shell", "entrypoint"]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/safeJson"
      }
    },
    "gitSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryUrl", "reference"],
      "properties": {
        "repositoryUrl": {
          "type": "string",
          "minLength": 8,
          "maxLength": 2048,
          "format": "uri"
        },
        "reference": {
          "$ref": "#/$defs/repositoryReference"
        },
        "credentialRef": {
          "$ref": "#/$defs/secretReference"
        }
      }
    },
    "jobCreation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "goal", "intensity", "displayName", "git"],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "goal": {
          "$ref": "#/$defs/jobGoal"
        },
        "intensity": {
          "$ref": "#/$defs/intensity"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "git": {
          "$ref": "#/$defs/gitSource"
        }
      }
    },
    "catalogTestId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 119,
      "pattern": "^[a-z0-9][a-z0-9.-]{1,118}$"
    },
    "loadStopConditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "errorRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "p95LatencyMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "maxFailedRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "loadExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "selector"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "source": {
          "type": "string",
          "enum": ["header", "json_body"]
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "loadAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "selector", "operator"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["header", "json_body"]
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "operator": {
          "type": "string",
          "enum": ["equals", "contains", "exists"]
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "loadProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rampUpSeconds", "durationSeconds", "maxRequests", "maxRequestsPerSecond"],
      "oneOf": [
        {
          "required": ["virtualUsers"],
          "not": {
            "required": ["arrivalRatePerSecond"]
          }
        },
        {
          "required": ["arrivalRatePerSecond"],
          "not": {
            "required": ["virtualUsers"]
          }
        }
      ],
      "properties": {
        "virtualUsers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "arrivalRatePerSecond": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100
        },
        "rampUpSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "maxRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxRequestsPerSecond": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100
        },
        "stopConditions": {
          "$ref": "#/$defs/loadStopConditions"
        }
      }
    },
    "loadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "expectedStatuses"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "method": {
          "$ref": "#/$defs/httpMethod"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^/"
        },
        "headers": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "secretHeaders": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "$ref": "#/$defs/secretReference"
          }
        },
        "dependsOn": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "extract": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/loadExtraction"
          }
        },
        "assertions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/loadAssertion"
          }
        },
        "bodyTemplate": {
          "$ref": "#/$defs/safeJson"
        },
        "expectedStatuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        }
      }
    },
    "loadScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "requests", "profile"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "requests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/loadRequest"
          }
        },
        "profile": {
          "$ref": "#/$defs/loadProfile"
        },
        "credentialRef": {
          "$ref": "#/$defs/secretReference"
        }
      }
    },
    "plannedTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogTestId",
        "name",
        "rationale",
        "risk",
        "expectedEvidence",
        "requiresExplicitConfirmation"
      ],
      "properties": {
        "catalogTestId": {
          "$ref": "#/$defs/catalogTestId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "risk": {
          "$ref": "#/$defs/risk"
        },
        "prerequisites": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "expectedEvidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "targetRequirements": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "requiresExplicitConfirmation": {
          "type": "boolean"
        },
        "configuration": {
          "$ref": "#/$defs/safeJsonObject"
        },
        "rationaleReferences": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "goal",
        "summary",
        "confidence",
        "plannedTests",
        "loadScenarios",
        "requiredInputs",
        "limitations"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "goal": {
          "$ref": "#/$defs/jobGoal"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "plannedTests": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/plannedTest"
          }
        },
        "loadScenarios": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/loadScenario"
          }
        },
        "requiredInputs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "evidenceReferences": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "targetScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "allowedHosts", "allowedPaths", "allowedPorts"],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 8,
          "maxLength": 2048,
          "format": "uri"
        },
        "allowedHosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^/"
          }
        },
        "allowedPorts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "targetLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRequestsPerSecond", "maxConcurrency", "maxDurationSeconds", "maxRequests"],
      "properties": {
        "maxRequestsPerSecond": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1000
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxDurationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "maxRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "targetAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "targetId",
        "authorizationMethod",
        "confirmed",
        "scope",
        "limits"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "targetId": {
          "$ref": "#/$defs/uuid"
        },
        "authorizationMethod": {
          "type": "string",
          "enum": ["explicit_confirmation", "ownership_verification"]
        },
        "confirmed": {
          "const": true
        },
        "scope": {
          "$ref": "#/$defs/targetScope"
        },
        "limits": {
          "$ref": "#/$defs/targetLimits"
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "runRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "runType",
        "jobId",
        "planId",
        "planVersion",
        "targetAuthorizationId",
        "idempotencyKey"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "runType": {
                "const": "vulnerability_testing"
              }
            },
            "required": ["runType"]
          },
          "then": {
            "required": ["plannedTestIds"],
            "properties": {
              "loadScenarioIds": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "runType": {
                "const": "load_testing"
              }
            },
            "required": ["runType"]
          },
          "then": {
            "required": ["loadScenarioIds"],
            "properties": {
              "plannedTestIds": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "runType": {
          "$ref": "#/$defs/jobGoal"
        },
        "jobId": {
          "$ref": "#/$defs/uuid"
        },
        "planId": {
          "$ref": "#/$defs/uuid"
        },
        "planVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "plannedTestIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "loadScenarioIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "targetAuthorizationId": {
          "$ref": "#/$defs/uuid"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "toolInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "runId", "catalogTestId", "outcome", "summary", "durationMs"],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "failed"
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "required": ["severity"]
          }
        }
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "runId": {
          "$ref": "#/$defs/uuid"
        },
        "catalogTestId": {
          "$ref": "#/$defs/catalogTestId"
        },
        "outcome": {
          "type": "string",
          "enum": ["passed", "failed", "skipped", "inconclusive", "error", "cancelled"]
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "details": {
          "$ref": "#/$defs/safeJsonObject"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "tool": {
          "$ref": "#/$defs/toolInfo"
        }
      }
    },
    "jobEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "jobId", "sequence", "type", "occurredAt"],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "jobId": {
          "$ref": "#/$defs/uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "enum": [
            "job.queued",
            "job.claimed",
            "job.retry_scheduled",
            "job.failed",
            "job.cancelled",
            "job.requeued",
            "repository.clone.started",
            "repository.snapshot.ready",
            "repository.clone.failed",
            "agent.discovery.progress",
            "plan.proposed",
            "plan.approved",
            "target.validated",
            "run.scheduled",
            "run.queued",
            "run.started",
            "run.cancelled",
            "run.completed",
            "run.failed",
            "test.started",
            "test.progress",
            "test.completed",
            "test.failed",
            "finding.recorded",
            "report.completed",
            "report.failed"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "$ref": "#/$defs/safeJson"
        }
      }
    },
    "runEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "runId", "sequence", "type", "occurredAt"],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "runId": {
          "$ref": "#/$defs/uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "enum": [
            "run.scheduled",
            "run.queued",
            "run.started",
            "run.cancelled",
            "run.completed",
            "run.failed",
            "test.started",
            "test.progress",
            "test.completed",
            "test.failed",
            "finding.recorded",
            "report.completed",
            "report.failed"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "$ref": "#/$defs/safeJson"
        }
      }
    }
  }
}
